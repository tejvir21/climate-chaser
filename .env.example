# Environment configuration for Climate Chaser.
# Copy to `.env` and fill in. Everything prefixed VITE_ is PUBLIC (inlined into
# the browser bundle at build time). Never put private secrets here.

# ─── Primary provider: Open-Meteo ────────────────────────────────────────────
# No key required. Weather, air quality, historical archive, and geocoding all
# work out of the box. Leave these unset unless you need to override defaults.

# ─── Secondary provider: OpenWeatherMap (optional) ───────────────────────────
# Enables a fallback when Open-Meteo is unreachable. Free tier: current + 5-day
# forecast only. Get a key at https://home.openweathermap.org/api_keys
# Older key name VITE_API_key is still honoured for backwards compatibility.
VITE_OPENWEATHER_API_KEY=

# ─── India official data: IMD (optional, requires registration) ───────────────
# Register at https://api.imd.gov.in/public/ to obtain credentials. The adapter
# is inert until both are set; alerts remain model-based estimates until then.
VITE_IMD_API_ENABLED=false
VITE_IMD_API_KEY=

# ─── First-run defaults ───────────────────────────────────────────────────────
VITE_DEFAULT_CITY=Noida
VITE_DEFAULT_COUNTRY=India