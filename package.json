{
    "name": "climate-chaser",
    "private": true,
    "version": "1.0.0",
    "description": "Climate Chaser - weather intelligence platform for India and the world. Current conditions, 16-day forecasts, air quality, maps, historical trends and travel planning. Powered by Open-Meteo (primary) and OpenWeatherMap (secondary).",
    "author": "Tejvir Chauhan",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/tejvir21/climate-chaser.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@hookform/resolvers": "^7.0.6",
        "@tanstack/react-query": "^5.107.1",
        "lucide-react": "^1.72.0",
        "maplibre-gl": "^6.18.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.92.0",
        "react-router-dom": "^7.18.5",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
        "zod": "^4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.10",
        "@types/node": "^26.6.6",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.6.2",
        "eslint": "^9.13.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "globals": "^15.11.0",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.32",
        "rollup": "^4.21.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^5.4.10",
        "vitest": "^2.1.9"
    }
}
